{
  "name": "@uniora/studio",
  "version": "0.7.0",
  "description": "UNIORA Studio: local-first admin UI for UNIORA data. Launched via `npx uniora studio`.",
  "license": "PolyForm-Shield-1.0.0",
  "keywords": [
    "uniora",
    "admin",
    "studio",
    "authorization"
  ],
  "homepage": "https://github.com/CodexSploitx/uniora#readme",
  "bugs": {
    "url": "https://github.com/CodexSploitx/uniora/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodexSploitx/uniora.git",
    "directory": "apps/studio"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/types",
    "!.next/diagnostics",
    "!.next/trace",
    "!.next/trace-build",
    "public",
    "next.config.mjs"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@uniora/core": "workspace:^",
    "@uniora/postgres": "workspace:^",
    "@uniora/sqlite": "workspace:^",
    "better-sqlite3": "^13.0.3",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@tabler/icons-react": "^3.48.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@uniora/mailer-smtp": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "next-themes": "^0.4.6",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@11.22.0",
  "peerDependencies": {
    "@uniora/mailer-smtp": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@uniora/mailer-smtp": {
      "optional": true
    }
  }
}
