# Copia este archivo a .env (nunca lo commitees) y ajusta los valores.

# Usa el mismo Postgres del docker-compose.yml de la raíz, pero UNA BASE DE
# DATOS PROPIA ("uniora_npm_consumer") — distinta de DATABASE_URL/
# TEST_DATABASE_URL/uniora_test_e2e — así esta verificación nunca toca datos
# de desarrollo, demo, ni de otras suites de test. verify.mjs la crea sola.
DATABASE_URL=postgresql://postgres:uniora@localhost:55432/uniora_npm_consumer
