# Copia este archivo a .env (nunca lo commitees) y ajusta los valores.

# Usada por @uniora/postgres (adapter), la CLI y Studio para datos reales.
# Debe apuntar al Postgres levantado con docker-compose.yml.
DATABASE_URL=postgresql://postgres:uniora@localhost:55432/uniora

# Usada SOLO por la suite de tests de @uniora/postgres. Debe ser una base de
# datos DISTINTA de DATABASE_URL: los tests truncan sus tablas entre cada
# test para aislarlos, así que si apuntara a la misma base que DATABASE_URL
# borraría cualquier dato real/de demo cada vez que corren. Se crea sola la
# primera vez que corres los tests (no hace falta `createdb` manual).
TEST_DATABASE_URL=postgresql://postgres:uniora@localhost:55432/uniora_test
