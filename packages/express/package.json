{
  "name": "@uniora/express",
  "version": "0.7.0",
  "description": "Express middleware and invitation routes for @uniora/core: deny-by-default authorization guards for routes. No hard dependency on the `express` package.",
  "license": "PolyForm-Shield-1.0.0",
  "keywords": [
    "uniora",
    "express",
    "authorization",
    "middleware"
  ],
  "homepage": "https://github.com/CodexSploitx/uniora#readme",
  "bugs": {
    "url": "https://github.com/CodexSploitx/uniora/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodexSploitx/uniora.git",
    "directory": "packages/express"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@uniora/core": "workspace:^"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.4",
    "express": "^5.1.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}
