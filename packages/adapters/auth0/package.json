{
  "name": "@uniora/auth0",
  "version": "0.3.0",
  "description": "Auth0 adapter for @uniora/core: turns an Auth0 access token into an Identity",
  "license": "PolyForm-Shield-1.0.0",
  "keywords": [
    "uniora",
    "auth0",
    "auth",
    "identity"
  ],
  "homepage": "https://github.com/CodexSploitx/uniora#readme",
  "bugs": {
    "url": "https://github.com/CodexSploitx/uniora/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodexSploitx/uniora.git",
    "directory": "packages/adapters/auth0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@uniora/core": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^2.1.4"
  }
}
