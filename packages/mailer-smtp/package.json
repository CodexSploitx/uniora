{
  "name": "@uniora/mailer-smtp",
  "version": "0.5.1",
  "description": "SMTP delivery for UNIORA invitations: configured from .env, with professional multilingual e-mail templates",
  "license": "PolyForm-Shield-1.0.0",
  "keywords": [
    "uniora",
    "smtp",
    "email",
    "invitations",
    "nodemailer"
  ],
  "homepage": "https://github.com/CodexSploitx/uniora#readme",
  "bugs": {
    "url": "https://github.com/CodexSploitx/uniora/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodexSploitx/uniora.git",
    "directory": "packages/mailer-smtp"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@uniora/core": "workspace:^",
    "nodemailer": "^10.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.19.17",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
