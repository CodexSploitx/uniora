{
  "name": "@uniora/server",
  "version": "0.9.0",
  "description": "UNIORA as its own self-hosted HTTP service: an authenticated, bounded, documented API over @uniora/core. Your backend calls it with an API key; your auth provider stays where it is.",
  "license": "PolyForm-Shield-1.0.0",
  "keywords": [
    "uniora",
    "authorization",
    "api",
    "multi-tenant",
    "server"
  ],
  "homepage": "https://github.com/CodexSploitx/uniora#readme",
  "bugs": {
    "url": "https://github.com/CodexSploitx/uniora/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodexSploitx/uniora.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.tests.json",
    "prepack": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@uniora/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@uniora/sqlite": "workspace:^",
    "@uniora/storage-conformance": "workspace:^",
    "better-sqlite3": "^13.0.3",
    "@types/better-sqlite3": "^9.6.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
