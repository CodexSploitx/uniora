# Dependencias
node_modules/

# Builds
dist/
*.tsbuildinfo

# Logs
*.log
pnpm-debug.log*

# Variables de entorno (ver .env.example)
.env
.env.*.local

# Sistema operativo / editor
.DS_Store
.vscode/*
!.vscode/extensions.json

# Contexto local de desarrollo: no se versiona (solo referencia local).
# Excepción: las skills del proyecto (.claude/skills/) y el CLAUDE.md raíz SÍ se versionan, para que
# las reglas del repositorio (p. ej. mantener las APIs al día) se apliquen en cualquier sesión.
.claude/*
!.claude/skills/
docs/
apps/*/CLAUDE.md
